# Development only. For normal use, put these settings in the configuration file
# shared by every MCP client: %LOCALAPPDATA%\foundryvtt-mcp\config.env (Windows),
# ~/.config/foundryvtt-mcp/config.env (macOS, Linux). Same syntax: put each value
# between '...' (between `...` if it contains an apostrophe).

# FoundryVTT Configuration
# Choose the URL that matches your setup:

# Local Development (default port)
FOUNDRY_URL=http://localhost:30000

# Reverse Proxy / Remote Server Examples:
# FOUNDRY_URL=https://foundry.example.com
# FOUNDRY_URL=http://foundry.example.com:8080
# FOUNDRY_URL=https://my-server.com:8443

# Local Network IP
# FOUNDRY_URL=http://192.168.1.100:30000

# Authentication: Username/Password (required)
# Use a FoundryVTT user account with appropriate permissions
FOUNDRY_USERNAME=your_username
FOUNDRY_PASSWORD='your_password'

# Optional: Direct user ID bypass
# Set to the 16-character document _id of the FoundryVTT user
# Skips username-to-ID resolution during Socket.IO authentication
# FOUNDRY_USER_ID=abc123def456ghij

# Optional: Diagnostics (requires REST API module)
# Install the "Foundry Local REST API" module and set the API key
# to enable the server monitoring tools (logs, health, diagnostics)
# FOUNDRY_API_KEY=your_api_key_here

# Write operations (game-state mutation) — disabled by default.
# When true, tools like update_actor_attributes / create_actor_item perform
# mutations over the authenticated Socket.IO session (modifyDocument protocol).
# Requires the connected user to have GM/owner permission in FoundryVTT.
# FOUNDRY_WRITE_ENABLED=true

# Optional: Foundry Module Bridge (Canvas, Screenshot, Live Rolls, Compendium Import)
# Enable the WebSocket bridge to communicate with the companion FoundryVTT module
# ("FoundryVTT MCP Bridge"). Enables capture_scene, roll_and_post, get_document_schema,
# and compendium-sourced actor item imports.
# FOUNDRY_MODULE_BRIDGE_ENABLED=true
# FOUNDRY_MODULE_BRIDGE_PORT=31415

# Optional: browser for the automatic headless GM session that hosts the module.
# Chrome, Edge, Brave, Vivaldi, Chromium, then Playwright's Chromium (`npx playwright install
# chromium`) are detected at their usual locations; set this to choose the browser (no fallback).
# FOUNDRY_HEADLESS_GM_EXECUTABLE_PATH=C:/Program Files/BraveSoftware/Brave-Browser/Application/brave.exe

# Optional: Local Data Path
# Absolute path to FoundryVTT's Data directory on the local machine.
# Enables image dimension introspection for list_scene_assets and automatic tile/scene sizing.
# FOUNDRY_DATA_PATH=C:/Users/me/AppData/Local/FoundryVTT/Data

# Logging (debug, info, warn, error)
LOG_LEVEL=info

# Optional: request timeout (ms) and REST request retries
FOUNDRY_TIMEOUT=10000
FOUNDRY_RETRY_ATTEMPTS=3
FOUNDRY_RETRY_DELAY=1000

# Notes:
# - Socket.IO with username/password is the primary connection method
# - All game data (actors, items, scenes, journals, combat, users) is loaded on connect
# - The companion module "FoundryVTT MCP Bridge" adds the canvas, dice, compendium and upload tools
# - Optional: Install "Foundry Local REST API" module for the server diagnostics tools
# - All communication is completely local - no external services
